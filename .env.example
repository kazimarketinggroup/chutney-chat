# ==========================================================
# Chutney & Chat — environment variables
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must NEVER be committed.
# ==========================================================

# ---------- SITE ----------
# Absolute URL of the site. Stripe redirects back here after payment.
# Local dev: http://localhost:3000
# Production: https://your-domain.com   (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------- SUPABASE ----------
# Supabase Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to expose in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET — server only. Bypasses all RLS.
# Never prefix this with NEXT_PUBLIC_ and never use it in a client component.
SUPABASE_SERVICE_ROLE_KEY=


# ---------- STRIPE ----------
# Stripe Dashboard -> Developers -> API keys
# Use sk_test_... / pk_test_... while testing, sk_live_... / pk_live_... when going live.

# Secret key. SECRET — server only.
STRIPE_SECRET_KEY=

# Publishable key. Safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...).
#  - Local:      run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#                and copy the whsec_ it prints.
#  - Production: Stripe Dashboard -> Developers -> Webhooks -> add endpoint
#                https://your-domain.com/api/webhooks/stripe  -> copy its signing secret.
# The local and production secrets are DIFFERENT values.
STRIPE_WEBHOOK_SECRET=


# ---------- EMAIL (already used by the contact form) ----------
# Gmail address used to send the ticket + payment receipt.
# Note: the variable is EMAIL_USER (not MAIL_USER).
EMAIL_USER=

# Gmail App Password (16 chars + spaces, from Google Account -> Security ->
# App passwords). Not your normal Gmail password. Keep the spaces as shown.
EMAIL_PASS=

# Where new-booking notifications are sent. Defaults to officialmdmahadi@gmail.com.
BOOKING_NOTIFY_EMAIL=
